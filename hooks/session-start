#!/usr/bin/env bash
# SessionStart hook for the GodMode plugin.
#
# Prints a JSON object whose context field carries the full using-godmode
# skill, so the model knows from its first turn that skills exist and must be
# checked before acting. Everything else is loaded on demand through the
# harness's skill mechanism.
#
# Written to survive the environments hooks really run in:
#   - no external commands: a startup hook can run with an empty PATH, so no
#     cat, dirname, sed or jq; only bash builtins and parameter expansion;
#   - one output shape per harness: Claude Code reads
#     hookSpecificOutput.additionalContext, Cursor reads additional_context,
#     Copilot CLI and other SDK-style harnesses read additionalContext. Emit
#     exactly one, because Claude Code reads both of its candidates without
#     deduplicating;
#   - printf piped through cat when cat exists, so a harness that closes
#     stdout early on Windows produces no "write error" diagnostic.

set -euo pipefail

case "$0" in
  */*|*\\*) SCRIPT_DIR="$(cd "${0%[/\\]*}" && pwd)" ;;
  *) SCRIPT_DIR="$(pwd)" ;;
esac
PLUGIN_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"

skill_md="${PLUGIN_ROOT}/skills/using-godmode/SKILL.md"
if [ -r "$skill_md" ]; then
  content="$(<"$skill_md")"
else
  content="Error: ${skill_md} is missing or unreadable. Run /godmode:doctor."
fi

escape_for_json() {
  local s="$1"
  s="${s//\\/\\\\}"
  s="${s//\"/\\\"}"
  s="${s//$'\n'/\\n}"
  s="${s//$'\r'/\\r}"
  s="${s//$'\t'/\\t}"
  printf '%s' "$s"
}

escaped="$(escape_for_json "$content")"
context="<EXTREMELY_IMPORTANT>\nYou have GodMode.\n\n**Below is the full content of your 'godmode:using-godmode' skill, your introduction to using skills. For every other skill, use the harness's skill mechanism as that skill describes:**\n\n${escaped}\n</EXTREMELY_IMPORTANT>"

emit_json() {
  # shellcheck disable=SC2059 # every caller passes a literal format string
  if command -v cat >/dev/null 2>&1; then
    printf "$@" | cat
  else
    printf "$@"
  fi
}

if [ -n "${CURSOR_PLUGIN_ROOT:-}" ]; then
  emit_json '{\n  "additional_context": "%s"\n}\n' "$context"
elif [ -n "${CLAUDE_PLUGIN_ROOT:-}" ] && [ -z "${COPILOT_CLI:-}" ]; then
  emit_json '{\n  "hookSpecificOutput": {\n    "hookEventName": "SessionStart",\n    "additionalContext": "%s"\n  }\n}\n' "$context"
else
  emit_json '{\n  "additionalContext": "%s"\n}\n' "$context"
fi

exit 0
